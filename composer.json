{
  "name": "moinferdi/chatbot",
  "type": "typo3-cms-extension",
  "description": "LLM chatbot widget for TYPO3 v13 — BYOK, OpenWebUI-first, proxy-backed",
  "license": "MIT",
  "authors": [
    {
      "name": "moinferdi",
      "role": "Developer"
    }
  ],
  "extra": {
    "typo3/cms": {
      "extension-key": "chatbot"
    }
  },
  "require": {
    "php": "^8.2 || ^8.3",
    "guzzlehttp/guzzle": "^7.0",
    "typo3/cms-core": "^13.4",
    "typo3/cms-frontend": "^13.4",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-fluid-styled-content": "^13.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "phpunit/phpunit": "^11.0",
    "saschaegerer/phpstan-typo3": "^2.0",
    "typo3/testing-framework": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Moinferdi\\Chatbot\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Moinferdi\\Chatbot\\Tests\\": "Tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "phpstan": "phpstan analyse",
    "phpstan:baseline": "phpstan analyse --generate-baseline"
  }
}
